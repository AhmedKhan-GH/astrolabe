# Data directory for Astrolabe database
# Leave empty to use default: ~/Library/Application Support/astrolabe/data (macOS)
# Or set a custom path for development
DATA_DIR=

# Service mode: 'local' or 'remote'
# local: Use local filesystem and database
# remote: Use remote API
SERVICE_MODE=local

# Remote API configuration (only used when SERVICE_MODE=remote)
REMOTE_API_URL=
REMOTE_API_KEY=
