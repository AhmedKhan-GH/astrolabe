{
  "name": "astrolabe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Local-first knowledge environment: the Alioth agent and Orion knowledge engine over Zotero, Obsidian, and Eagle.",
  "author": "Ahmed <emailahmedebadkhan@gmail.com>",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.app.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "test:unit": "vitest run --project unit --project components",
    "test:integration": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --project integration",
    "test": "pnpm test:unit && pnpm test:integration",
    "package:dir": "pnpm build && electron-builder --dir",
    "dev:install:mac": "bash scripts/install-dev-mac.sh"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "pino": "^10.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
